{
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "routes": [
    {
      "route": "/wp-content/uploads/*",
      "redirect": "/uploads/:splat",
      "statusCode": 301
    },
    {
      "route": "/feed",
      "redirect": "/index.xml",
      "statusCode": 301
    },
    {
      "route": "/speaker",
      "redirect": "/speaking",
      "statusCode": 301
    }
  ]
}
